# Per-user Hermes image — runs always-on as one Fly Machine per user.
# Built FROM Hermes' official Dockerfile. Customizations live in the image
# filesystem (/opt/hermes-user-config/, /opt/hermes-hooks/, /usr/local/bin/)
# and are synced to /opt/data (the volume mount) on every boot by our
# launcher script.
#
# Build + push to Fly registry:
#   docker login registry.fly.io -u x --password "$FLY_API_TOKEN"
#   docker build --platform linux/amd64 -f Dockerfile.hermes-user \
#       -t registry.fly.io/hermes-user-image:v21 .
#   docker push registry.fly.io/hermes-user-image:v21
#
# Base is PINNED to an exact upstream tag (never :latest) so an upstream cut
# can't silently change what the fleet boots. Currently v2026.7.20.
#
# s6-overlay (PID1 = /init) landed upstream in v2026.5.28. We stayed on
# v2026.5.16 until 2026-07-27 believing s6 dropped our CMD — it does not.
# Upstream splits it deliberately:
#
#   ENTRYPOINT [ "/init", "/opt/hermes/docker/main-wrapper.sh" ]
#   CMD        [ ]
#
# so a downstream CMD is APPENDED as arguments to main-wrapper.sh, whose
# routing is: no args -> `hermes`; first arg is an executable -> exec it
# directly; anything else -> `hermes <args>`. Our CMD below is on PATH, so it
# takes the bare-executable branch and main-wrapper drops to the hermes user
# via `s6-setuidgid hermes` — the same privilege drop the pre-s6
# entrypoint.sh gave us through gosu.
#
# Two upstream details this image depends on:
#   - docker/s6-rc.d/main-hermes/run is `exec sleep infinity` (a deliberate
#     no-op slot), so nothing competes with the gateway our launcher starts.
#   - the `dashboard` s6 service self-disables unless HERMES_DASHBOARD is
#     truthy. We never set it, so it exits 0 and stays down — no extra
#     process and nothing else binding a port.
#
# Do NOT bump this tag without re-reading upstream's Dockerfile ENTRYPOINT /
# main-wrapper.sh routing — that contract is what makes our CMD work.

FROM nousresearch/hermes-agent:v2026.7.20

USER root

# ----- trim off-product bundled skills (Marketing PA) -----
# The base image bundles ~85 skills under /opt/hermes/skills/<category>/<slug>
# and Hermes re-syncs them into /opt/data/skills on every boot. Delete the
# off-product ones (dev tooling, ML research, games/media, macOS-only, etc.)
# from the bundle SOURCE here so they can never be re-synced. The launcher also
# prunes them from existing /opt/data volumes on boot (same denylist file).
COPY docker/hermes-user/skill-denylist.txt /opt/hermes-user-config/skill-denylist.txt
RUN grep -vE '^\s*#|^\s*$' /opt/hermes-user-config/skill-denylist.txt | while IFS= read -r s; do \
      find /opt/hermes/skills -depth -type d -name "$s" -exec rm -rf {} + ; \
    done

# ----- curated skill packs (image-fs, NOT in /opt/data) -----
# We bake them under /opt/hermes-user-config/skills/ and the launcher rsyncs
# to /opt/data/skills/ on every boot (idempotent, user customizations to
# specific skill dirs survive).

RUN mkdir -p /opt/hermes-user-config/skills /opt/hermes-user-config/skills/meta \
 && cd /tmp \
 && git clone --depth 1 https://github.com/coreyhaines31/marketingskills.git \
 && cp -r marketingskills/skills/* /opt/hermes-user-config/skills/ \
 && git clone --depth 1 https://github.com/conorbronsdon/avoid-ai-writing.git \
 && mkdir -p /opt/hermes-user-config/skills/avoid-ai-writing \
 && cp avoid-ai-writing/SKILL.md /opt/hermes-user-config/skills/avoid-ai-writing/SKILL.md \
 && if [ -f avoid-ai-writing/CLAUDE.md ]; then cp avoid-ai-writing/CLAUDE.md /opt/hermes-user-config/skills/avoid-ai-writing/CLAUDE.md ; fi \
 && git clone --depth 1 https://github.com/Romanescu11/hermes-skill-factory.git \
 && mkdir -p /opt/hermes-user-config/skills/meta/skill-factory \
 && cp hermes-skill-factory/skills/skill-factory/SKILL.md /opt/hermes-user-config/skills/meta/skill-factory/SKILL.md \
 && git clone --depth 1 https://github.com/AgriciDaniel/claude-ads.git \
 && for d in claude-ads/skills/*/; do cp -r "$d" /opt/hermes-user-config/skills/ ; done \
 && git clone --depth 1 https://github.com/nowork-studio/toprank.git \
 && for cat in seo google-ads meta-ads gemini; do \
      if [ -d "toprank/$cat" ]; then \
        for d in toprank/$cat/*/; do \
          if [ -f "$d/SKILL.md" ]; then cp -r "$d" "/opt/hermes-user-config/skills/tr-$cat-$(basename "$d")" ; fi ; \
        done ; \
      fi ; \
    done \
 && rm -rf /tmp/marketingskills /tmp/avoid-ai-writing /tmp/hermes-skill-factory /tmp/claude-ads /tmp/toprank \
 && chmod -R a+rX /opt/hermes-user-config/skills

# ----- re-add creative-ideation (unbundled upstream in v2026.6.5) -----
# Upstream moved it from skills/ to optional-skills/ when it trimmed the
# default bundle 91 -> 74. Hermes prunes the volume to match the bundle, so
# without this it vanishes from EXISTING machines on upgrade, not just new
# ones (verified on the v27 -> v28 volume test). It is the one unbundled
# skill with real Marketing-PA relevance, and the v2026.7.20 copy is much
# richer than the one we shipped before (28 files vs 5: anti-slop,
# heuristics, method-catalog, exercises, full prompt library).
#
# Copied from the BASE IMAGE rather than fetched, so it is always the exact
# version that matches the pinned upstream tag and the build needs no
# network for it.
RUN cp -r /opt/hermes/optional-skills/creative/creative-ideation \
      /opt/hermes-user-config/skills/creative-ideation \
 && chmod -R a+rX /opt/hermes-user-config/skills/creative-ideation

# ----- orchestrator-owned skills (schedule-task mirror, outbox-send) -----
# Layered AFTER the third-party packs so ours win on any name collision.

COPY docker/hermes-user/skills/ /opt/hermes-user-config/skills/

# ----- operator SOUL + config (image-fs) -----

COPY docker/hermes-user/SOUL.md /opt/hermes-user-config/SOUL.md
COPY docker/hermes-user/config.yaml /opt/hermes-user-config/config.yaml

# ----- post_llm_call shell hook (image-fs, referenced by config.yaml) -----

COPY docker/hermes-user/cron-outbox-bridge.sh /opt/hermes-hooks/cron-outbox-bridge.sh

# ----- bootstrap-on-boot launcher -----
# Composes /opt/data/.env from Fly env vars, syncs SOUL.md / config.yaml /
# skills from /opt/hermes-user-config/ → /opt/data/, then exec's hermes.
# Upstream entrypoint.sh sees this on PATH and exec's it directly.

COPY docker/hermes-user/hermes-user-launcher /usr/local/bin/hermes-user-launcher

# NOTE: we deliberately install NO /etc/cont-init.d hook. Because the
# ENTRYPOINT below bypasses /init entirely, cont-init never runs — including
# upstream's 02-reconcile-profiles, whose supervised-gateway auto-start was
# the collision an earlier revision of this image needed a hook to suppress.
# No /init, no reconciler, no collision.

# Permissions in one layer so the upstream `chown -R hermes:hermes /opt/hermes`
# from the base image's RUN steps doesn't fight us. We make our config dir
# world-readable; the volume mount will be world-writable for the hermes
# user after upstream's entrypoint chown.
RUN chmod +x /usr/local/bin/hermes-user-launcher /opt/hermes-hooks/cron-outbox-bridge.sh \
 && chmod -R a+rX /opt/hermes-user-config /opt/hermes-hooks

# Install jq (required by the cron-outbox-bridge hook for JSON parsing).
RUN apt-get update && apt-get install -y --no-install-recommends jq \
 && rm -rf /var/lib/apt/lists/*

# Skip upstream's per-boot config-schema migration (stage2-hook runs
# scripts/docker_config_migrate.py unless this is set).
#
# It is pure waste for this image and it LEAKS FILES. Our launcher rewrites
# config.yaml from /opt/hermes-user-config on every boot, so the persisted
# config is always schema 0 again by the time Hermes reads it — the migration
# runs, reports "Migrating config schema 0 -> 33", writes a timestamped
# config.yaml.bak-<ts> (and sometimes .env.bak-<ts>) to the DURABLE volume,
# and its output is then overwritten by us and discarded. Measured: exactly
# one backup file per boot, forever, on a volume that outlives every image
# roll, deploy and crash-restart.
#
# The orchestrator profile IS the source of truth for config.yaml here, so
# there is nothing for a schema migration to preserve. Re-enable this (drop
# the ENV) only if the launcher ever stops overwriting config.yaml.
ENV HERMES_SKIP_CONFIG_MIGRATION=1

VOLUME ["/opt/data"]
EXPOSE 8642

# We REPLACE upstream's ENTRYPOINT (`/init /opt/hermes/docker/main-wrapper.sh`)
# rather than layering a CMD onto it.
#
# s6-overlay's suexec hard-requires PID 1. Under `docker run` /init IS pid 1,
# so the stock entrypoint works and every local test passes. On Fly it never
# is — flyd's init owns pid 1 and runs the image entrypoint as a child — so
# /init dies instantly with `s6-overlay-suexec: fatal: can only run as pid 1`
# and exit code 100, boot-looping until Fly gives up. Verified in production
# 2026-07-27 (see the launcher header). Since these machines only ever run on
# Fly, the s6 supervision tree is unusable here and we skip it.
#
# The launcher re-creates the pre-s6 contract itself: it starts as root, runs
# upstream's stage2-hook, applies the orchestrator profile, then drops to the
# hermes user via s6-setuidgid and exec's the gateway in the foreground. The
# container's lifetime is the gateway's, which is what Fly's
# `restart: policy always` and the machine-roll path assume.
#
# ENTRYPOINT (not CMD) so `docker run <image> <args>` still forwards args to
# the gateway, and so no orchestration layer can accidentally drop it.
ENTRYPOINT ["hermes-user-launcher"]
CMD []
