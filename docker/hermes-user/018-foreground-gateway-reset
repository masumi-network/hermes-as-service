#!/command/with-contenv sh
# Clear the stale gateway run-state before upstream's profile reconciler.
#
# WHY THIS EXISTS
# ---------------
# We run the gateway in the FOREGROUND as the container's main program
# (hermes-user-launcher -> `hermes gateway run --no-supervise`), so the
# container's lifetime is the gateway's and Fly's `restart: policy always`
# is the recovery path. That is the pre-s6 contract the orchestrator's
# health checks and machine-roll logic assume.
#
# Upstream's /etc/cont-init.d/02-reconcile-profiles re-creates the
# per-profile s6 service slots on every container boot and AUTO-STARTS any
# profile whose last recorded state was `running`
# ($HERMES_HOME/gateway_state.json). Our foreground gateway writes exactly
# that state while it is alive and never gets to clear it when the machine
# is stopped or rolled — so on the NEXT boot the reconciler starts a
# SUPERVISED gateway for profile `default`, and our launcher then refuses:
#
#   ✗ A gateway is already running under s6 (container supervisor) for this
#     profile. ... Pass --force to start a foreground gateway anyway
#
# main program exits 1 -> /init tears the container down -> Fly restarts ->
# same thing again. Caught by the boot smoke test on 2026-07-27; a first
# boot succeeds and only the RESTART fails, which is the path every machine
# roll takes.
#
# A persisted `running` is always stale here by construction: the process it
# names died with the previous container. Removing the file makes every boot
# look like a first boot to the reconciler, which registers the slot `down`
# (verified) and leaves the foreground gateway unopposed. Hermes rewrites
# the file as soon as the gateway starts.
#
# Do NOT "fix" the collision with --force instead: that runs the supervised
# and foreground gateways CONCURRENTLY against shared state, which is the
# corruption upstream's guard exists to prevent.
set -e

HERMES_HOME="${HERMES_HOME:-/opt/data}"
state="$HERMES_HOME/gateway_state.json"

if [ -f "$state" ]; then
    rm -f "$state" 2>/dev/null || true
    echo "[hermes-user] cleared stale $state so the reconciler leaves gateway-default down"
fi
