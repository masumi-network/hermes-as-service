#!/usr/bin/env bash
# hermes-user-launcher
#
# This script IS the container ENTRYPOINT, and it starts as ROOT. It does
# not go through upstream's `/init` (s6-overlay) at all.
#
# WHY WE BYPASS s6-overlay
# ------------------------
# The v2026.7.20 image's own ENTRYPOINT is `/init main-wrapper.sh`, and s6's
# `s6-overlay-suexec` hard-requires PID 1. That holds under `docker run`
# (where /init IS pid 1) but NEVER on Fly: flyd's init owns pid 1 inside the
# Firecracker VM and runs the image entrypoint as a child. Observed in
# production 2026-07-27:
#
#   Preparing to run: `/init /opt/hermes/docker/main-wrapper.sh ...` as root
#   s6-overlay-suexec: fatal: can only run as pid 1
#   Main child exited normally with code: 100
#
# 13 restarts, then Fly stopped the machine. Local Docker testing cannot
# reproduce this — it passes there by construction. Pre-s6 tini only WARNED
# about not being pid 1 and carried on, which is why v27 was unaffected.
#
# So we re-create the pre-s6 contract ourselves, as root:
#   0. run upstream's stage2-hook (uid/gid remap, volume chown, first-boot
#      config seed, skills sync) — the work /etc/cont-init.d/01-hermes-setup
#      would have done under /init.
#   1. Compose /opt/data/.env from Fly env vars (so Hermes' subprocess
#      sandbox sees them — they're NOT inherited otherwise).
#   2. Sync /opt/hermes-user-config/{SOUL.md,config.yaml,skills/} →
#      /opt/data/ on every boot. Idempotent; overrides any drift on the
#      volume so the orchestrator's profile is always source of truth.
#   3. chown what we wrote to hermes, then drop and exec the gateway.
#
# Bypassing /init also means upstream's 02-reconcile-profiles never runs, so
# the supervised-gateway collision it caused (and the cont-init hook we added
# to work around it) is gone with it — nothing else can claim the profile.

set -euo pipefail

export HERMES_HOME=/opt/data
mkdir -p "$HERMES_HOME"

# s6-overlay installs its utilities under /command and /package/admin, and
# normally /init puts them on PATH before anything runs. We skip /init, so we
# must do it ourselves: stage2-hook calls `s6-setuidgid` by BARE NAME (its
# as_hermes helper), and without this the hook dies with
# `s6-setuidgid: not found` and the container exits 127.
export PATH="/command:/package/admin/s6/command:$PATH"

# ---- 0. upstream bootstrap (normally cont-init.d/01-hermes-setup) ----
# Invoked directly rather than through docker/entrypoint.sh: that shim is
# deprecated, prints a migration warning, and forwards here anyway. Failure
# is fatal on purpose — it owns volume ownership, and continuing past it
# would run the agent against a volume it may not be able to write.
if [ -x /opt/hermes/docker/stage2-hook.sh ]; then
  /opt/hermes/docker/stage2-hook.sh
fi

# ---- 1. .env from Fly env vars ----
{
  for var in \
      API_SERVER_ENABLED API_SERVER_HOST API_SERVER_PORT API_SERVER_KEY \
      API_SERVER_MODEL_NAME \
      OPENROUTER_API_KEY OPENROUTER_BASE_URL \
      HERMES_HOME TERMINAL_ENV HERMES_QUIET \
      GATEWAY_ALLOW_ALL_USERS \
      EXA_API_KEY \
      ORCHESTRATOR_BASE INSTANCE_ID ORCHESTRATOR_OUTBOX_TOKEN \
      HINDSIGHT_MODE HINDSIGHT_API_KEY HINDSIGHT_BANK_ID \
      MCP_SERVERS_JSON; do
    val="${!var-}"
    if [ -n "$val" ]; then
      if [[ "$val" =~ [[:space:]\#\"] ]]; then
        printf '%s="%s"\n' "$var" "${val//\"/\\\"}"
      else
        printf '%s=%s\n' "$var" "$val"
      fi
    fi
  done
} > "$HERMES_HOME/.env"
chmod 0600 "$HERMES_HOME/.env"

# ---- 2. sync operator config from image-fs → volume ----

# Always overwrite — orchestrator profile is source of truth. Hermes also
# bootstraps a SOUL.md and config.yaml from /opt/hermes/docker/* on first
# boot via the upstream entrypoint; we override that here.
cp -f /opt/hermes-user-config/SOUL.md  "$HERMES_HOME/SOUL.md"

# The user's chosen assistant name goes into SOUL — i.e. into the SYSTEM
# PROMPT of every turn. It used to travel only in the onboarding prompt, so it
# lived in memory alone; memory loses to the system prompt, and an assistant
# the user had named "Codi" still answered "I'm Hermes" and corrected them.
# Appended (not templated) so an unnamed instance keeps the file byte-identical.
if [ -n "${HERMES_PERSONA_NAME:-}" ]; then
  {
    printf '\n## YOUR NAME\n\n'
    printf 'The user named you **%s**. That is your name — introduce yourself\n' "$HERMES_PERSONA_NAME"
    printf 'as %s, answer to it, and sign proactive messages with it. Never\n' "$HERMES_PERSONA_NAME"
    printf 'reply "I am Hermes" to someone addressing you as %s.\n' "$HERMES_PERSONA_NAME"
  } >> "$HERMES_HOME/SOUL.md"
fi
cp -f /opt/hermes-user-config/config.yaml "$HERMES_HOME/config.yaml"

# ---- 2a. Pin the LLM endpoint to the orchestrator's proxy ----
#
# The agent MUST reach the LLM through the orchestrator (metering, the
# per-user spend cap, and the real OpenRouter key never landing on a
# machine). Until v2026.5.16 the OPENROUTER_BASE_URL env var was enough:
# the runtime read it per-request. On v2026.7.20 it is NOT: the runtime
# resolves the provider through its catalog and only consults that env var
# far down a precedence chain it never reaches for a catalog-routed model.
# Observed in production 2026-07-28 — every turn died in 40ms:
#
#   Provider: openrouter  Endpoint: https://openrouter.ai/api/v1/
#   HTTP 401: Missing Authentication header      (usage.prompt_tokens = 0)
#
# i.e. it went STRAIGHT to OpenRouter carrying our proxy token, which
# OpenRouter has never seen. Failing closed, so nothing leaked — but no
# turn could complete and the user just saw "empty response".
#
# THE lever that works (verified empirically with a fake URL before
# shipping): `model.base_url` + `model.api_key` in config.yaml, with
# `model.provider` left unset. runtime_provider.py honours that
# combination directly (the issue-#3846 path: a config base_url whose host
# is not a known cloud root is routed to as-is, and _resolve_openrouter_
# runtime's use_config_base_url branch requires provider empty/auto).
# Two config surfaces that look right but DO NOT work on this base, both
# tested: a config.yaml `providers:` entry (only consulted for provider
# LOOKUP BY NAME, not catalog-routed models) and `hermes auth add
# openrouter` (stores under credential_pool["custom:openrouter"], which
# the openrouter runtime path never reads).
#
# python3 round-trip instead of a heredoc append: `model:` already exists
# in the baked config, and a second `model:` mapping would be a duplicate
# top-level key — PyYAML would take the last one silently today and break
# loudly the day upstream switches loaders.
if [ -n "${OPENROUTER_BASE_URL:-}" ]; then
  OPENROUTER_BASE_URL="$OPENROUTER_BASE_URL" OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}" \
  python3 - "$HERMES_HOME/config.yaml" <<'PYEOF'
import os, sys, yaml
path = sys.argv[1]
with open(path) as f:
    cfg = yaml.safe_load(f) or {}
model = cfg.get("model")
if not isinstance(model, dict):
    model = {"default": model} if isinstance(model, str) and model.strip() else {}
model["base_url"] = os.environ["OPENROUTER_BASE_URL"]
key = os.environ.get("OPENROUTER_API_KEY", "")
if key:
    model["api_key"] = key
# provider must stay unset/auto — an explicit provider disables the
# use_config_base_url branch and the whole pin silently stops working.
model.pop("provider", None)
cfg["model"] = model
with open(path, "w") as f:
    yaml.safe_dump(cfg, f, default_flow_style=False, sort_keys=False)
PYEOF
fi

# ---- 2b. Hindsight long-term memory (native provider, mode local_external) ----
# The orchestrator passes HINDSIGHT_API_URL (its own per-instance proxy) and
# HINDSIGHT_BANK_ID (this user's id). We write the provider's config.json and
# switch memory.provider on. When HINDSIGHT_API_URL is absent the whole
# feature stays off and Hermes keeps its built-in memory only.
if [ -n "${HINDSIGHT_API_URL:-}" ]; then
  mkdir -p "$HERMES_HOME/hindsight"
  cat > "$HERMES_HOME/hindsight/config.json" <<HSEOF
{
  "mode": "local_external",
  "api_url": "${HINDSIGHT_API_URL}",
  "bank_id": "${HINDSIGHT_BANK_ID:-hermes}",
  "memory_mode": "hybrid",
  "auto_retain": true,
  "auto_recall": true,
  "retain_async": true,
  "recall_budget": "mid",
  "retain_context": "conversation between Hermes and the user"
}
HSEOF
  chmod 0600 "$HERMES_HOME/hindsight/config.json"
  printf '\nmemory:\n  provider: hindsight\n' >> "$HERMES_HOME/config.yaml"
fi

# ---- 2b. MCP servers (HTTP-based, from OAuth broker) ----
# MCP_SERVERS_JSON is set by the orchestrator when the user has connected
# integrations (Gmail, Outlook, Calendar, etc.). Shape:
#   [{"name":"gmail",
#     "url":"https://backend.composio.dev/v3/mcp/<id>?user_id=<u>",
#     "headers":{"x-api-key":"ak_..."}}]
# Headers is a free-form string→string map; the orchestrator decides what
# auth scheme to attach (Composio = x-api-key, future brokers = whatever).
# We append a `mcp_servers:` block to config.yaml so Hermes loads them on
# gateway start. Restart the machine to pick up changes after add/remove.
if [ -n "${MCP_SERVERS_JSON-}" ] && [ "$MCP_SERVERS_JSON" != "[]" ]; then
  # Hermes expects mcp_servers as a YAML MAP keyed by server name
  # (it iterates with .items()), not a list of {name, ...} entries.
  # Schema:
  #   mcp_servers:
  #     gmail:
  #       transport: streamable_http
  #       url: https://...
  #       headers:
  #         x-api-key: "..."
  yaml_block=$(printf '%s' "$MCP_SERVERS_JSON" | jq -r '
    "\nmcp_servers:\n" +
    ([.[] |
      "  \(.name):\n" +
      "    transport: streamable_http\n" +
      "    url: \(.url)\n" +
      (if (.headers // {}) | length > 0 then
        "    headers:\n" +
        ([(.headers | to_entries[]) |
          "      \(.key): \"\(.value | tostring | gsub("\""; "\\\""))\"\n"
        ] | join(""))
       else "" end)
    ] | join(""))
  ' 2>/dev/null || true)
  if [ -n "$yaml_block" ]; then
    printf '%s' "$yaml_block" >> "$HERMES_HOME/config.yaml"
  fi
fi

# Skills: ensure curated skill packs are present. We use a simple
# "copy if missing or older" rule — preserves any user-added skills.
mkdir -p "$HERMES_HOME/skills" "$HERMES_HOME/skills/meta"
for src in /opt/hermes-user-config/skills/*/; do
  [ -d "$src" ] || continue
  name=$(basename "$src")
  dest="$HERMES_HOME/skills/$name"
  if [ ! -d "$dest" ] || [ "$src" -nt "$dest" ]; then
    rm -rf "$dest"
    cp -r "$src" "$dest"
  fi
done
# also the meta/* subdir (skill-factory)
for src in /opt/hermes-user-config/skills/meta/*/; do
  [ -d "$src" ] || continue
  name=$(basename "$src")
  dest="$HERMES_HOME/skills/meta/$name"
  if [ ! -d "$dest" ] || [ "$src" -nt "$dest" ]; then
    rm -rf "$dest"
    cp -r "$src" "$dest"
  fi
done

# Our baked creative-ideation supersedes the stale bundled copy that older
# volumes still carry at skills/creative/creative-ideation. Upstream unbundled
# it in v2026.6.5 but Hermes does NOT prune skills that leave the bundle, so an
# upgraded volume keeps the old 2-file version alongside our 28-file one and
# the index shows the same skill twice. Delete the nested one only — the
# denylist can't express this because `find -name creative-ideation` would
# match ours too.
rm -rf "$HERMES_HOME/skills/creative/creative-ideation"

# Prune off-product bundled skills from the volume (Marketing PA). The image
# already deletes these from the bundle source so Hermes won't re-sync them;
# this cleans EXISTING /opt/data volumes (persisted across an image roll).
# Denylist is one leaf slug per line; '#' comments + blanks ignored.
denylist=/opt/hermes-user-config/skill-denylist.txt
if [ -f "$denylist" ]; then
  grep -vE '^[[:space:]]*#|^[[:space:]]*$' "$denylist" | while IFS= read -r s; do
    [ -n "$s" ] || continue
    find "$HERMES_HOME/skills" -depth -type d -name "$s" -exec rm -rf {} + 2>/dev/null || true
  done
fi

# Standard Hermes home subdirs (Hermes creates these lazily but explicit is
# safer for cron's filesystem layout).
mkdir -p "$HERMES_HOME"/{sessions,logs,memories,workspace,home,cron,cron/output}

# ---- 3. hand the volume to hermes, then drop and exec the gateway ----
#
# Everything above ran as root, so anything we just created is root-owned and
# unreadable to the unprivileged runtime. stage2-hook chowned the volume
# BEFORE our writes, so re-chown what we touched.
chown -R hermes:hermes \
  "$HERMES_HOME/.env" "$HERMES_HOME/SOUL.md" "$HERMES_HOME/config.yaml" \
  "$HERMES_HOME/skills" "$HERMES_HOME/hindsight" 2>/dev/null || true
chown hermes:hermes "$HERMES_HOME" 2>/dev/null || true

# What main-wrapper.sh would have set up for us under /init.
export HOME="$HERMES_HOME"
export PATH="/opt/hermes/.venv/bin:$PATH"
cd "$HERMES_HOME"

# `gateway run` (bare `gateway` defaults to it) auto-redirects to the
# supervised s6 service when it detects one. We have no s6 tree at all, so
# the redirect should never trigger — but pass --no-supervise explicitly so
# the foreground contract is stated, not inferred: the gateway IS the
# container's main process and the container exits with its exit code, which
# is what Fly's `restart: policy always` and the machine-roll path assume.
#
# NOTE: --no-supervise only exists on v2026.5.28+ bases. This line and the
# Dockerfile's FROM must move together.
exec /command/s6-setuidgid hermes \
  /opt/hermes/.venv/bin/hermes gateway run --no-supervise "$@"
